# Copy to apps/api/.env (gitignored). Never commit real values.

# --- Service -------------------------------------------------------------
ENV=development                 # development | test | production
LOG_LEVEL=INFO
LOG_JSON=false                  # true in deployed environments

# --- HTTP / CORS ---------------------------------------------------------
# Comma-separated explicit origins. Wildcards are rejected at startup.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database ------------------------------------------------------------
# Runtime connection as the application role (read/write on schema `app` only).
# On Neon you may use the POOLED endpoint here (host contains "-pooler").
DATABASE_URL=postgresql+asyncpg://sageboard_app:change-me-app@localhost:5432/sageboard
# Migrations run as the owner role. On Neon this MUST be the DIRECT endpoint.
MIGRATION_DATABASE_URL=postgresql+asyncpg://sageboard_owner:change-me-owner@localhost:5432/sageboard
# Creates dataset schemas + reader roles and loads CSV / demo data (COPY). Never used for queries.
INGEST_DATABASE_URL=postgresql+asyncpg://sageboard_ingest:change-me-ingest@localhost:5432/sageboard
# Read-only role for previews (and, from Phase 4, validated agent SQL). Each query switches
# to the dataset's own reader role inside a READ ONLY transaction with a timeout.
EXECUTOR_DATABASE_URL=postgresql+asyncpg://sageboard_executor:change-me-executor@localhost:5432/sageboard
EXECUTOR_STATEMENT_TIMEOUT_MS=10000

# --- Uploads -------------------------------------------------------------
UPLOAD_MAX_BYTES=26214400        # 25 MB
UPLOAD_MAX_ROWS=1000000
UPLOAD_MAX_COLUMNS=200
UPLOAD_TTL_MINUTES=60            # unreviewed uploads are deleted after this
# UPLOAD_DIR=/tmp/sageboard-uploads   # default: system temp dir; created with mode 0700
PREVIEW_MAX_ROWS=100

# --- Authentication ------------------------------------------------------
# "session" = real accounts (default). "demo" = every request acts as the seeded demo
# user (local experiments only; refused when ENV=production).
AUTH_MODE=session
# Required for AUTH_MODE=session: at least 32 random bytes. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
# Cookies. Locally: open the web app at http://localhost:3000 and point it at
# http://localhost:8000 (same site). Production on two different domains needs
# COOKIE_SAMESITE=none (Secure is automatic when ENV=production).
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
LOGIN_ATTEMPTS_PER_MINUTE=5
REGISTRATIONS_PER_HOUR=10
UPLOADS_PER_HOUR=20
DEMO_USER_EMAIL=demo@sageboard.local
# Size of the sample dataset users load from the Data page: small | standard
DEMO_DATASET_SCALE=standard

# --- LLM (the analysis agent) ---------------------------------------------
# google | anthropic | openai | mock.
# `mock` configures NO model: questions are saved but stay queued (nothing is made up).
# It is refused when ENV=production.
#
# Free option (recommended for development): Google Gemini via Google AI Studio.
#   1. https://aistudio.google.com → Get API key → create a key in a project with
#      NO billing account linked. Without billing, Google cannot charge you: requests
#      beyond the free quota are refused (HTTP 429), never billed.
#   2. Set the three lines below, then run: uv run python scripts/check_llm.py
#   Free-tier note: Google may use prompts and responses sent on the free tier to
#   improve its products, so use the sample dataset or non-sensitive data.
LLM_PROVIDER=mock
LLM_MODEL=
# LLM_PROVIDER=google
# LLM_MODEL=gemini-3.8-flash
GOOGLE_API_KEY=
# Paid providers (only if you choose them):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: an OpenAI-compatible gateway URL, request timeout, output cap.
# LLM_BASE_URL=
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_OUTPUT_TOKENS=8192     # thinking models spend part of it reasoning
# Gemini/OpenAI: think less per call (faster, fewer tokens). none|minimal|low|medium|high
# LLM_REASONING_EFFORT=low
# Set false for models that reject a temperature parameter.
# LLM_SEND_TEMPERATURE=true

# --- Agent budgets (per question) -------------------------------------------
# AGENT_MAX_LLM_CALLS=30
# AGENT_MAX_SQL_EXECUTIONS=14
# AGENT_DEADLINE_SECONDS=180
# AGENT_MAX_RESULT_ROWS=5000
# ANALYSES_PER_HOUR=30
# With free-tier pacing, a 6-step question can take a few minutes:
# AGENT_DEADLINE_SECONDS=420

# --- Free-tier protection ---------------------------------------------------
# Client-side pacing (requests per minute, shared by all runs). Keep it at or below
# your model's free-tier RPM shown in AI Studio. 0 = off.
# LLM_REQUESTS_PER_MINUTE=10
# Stop starting new analyses after this many model calls per day (resets midnight
# Pacific, like Google's quota). Keep it at or below your model's free-tier RPD. 0 = off.
# LLM_DAILY_REQUEST_LIMIT=200
