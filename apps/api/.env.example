# Copy to apps/api/.env (gitignored). Never commit real values.

# --- Service -------------------------------------------------------------
ENV=development                 # development | test | production
LOG_LEVEL=INFO
LOG_JSON=false                  # true in deployed environments

# --- HTTP / CORS ---------------------------------------------------------
# Comma-separated explicit origins. Wildcards are rejected at startup.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database ------------------------------------------------------------
# Runtime connection as the application role (read/write on schema `app` only).
# On Neon you may use the POOLED endpoint here (host contains "-pooler").
DATABASE_URL=postgresql+asyncpg://sageboard_app:change-me-app@localhost:5432/sageboard
# Migrations run as the owner role. On Neon this MUST be the DIRECT endpoint.
MIGRATION_DATABASE_URL=postgresql+asyncpg://sageboard_owner:change-me-owner@localhost:5432/sageboard
# Creates dataset schemas + reader roles and loads CSV / demo data (COPY). Never used for queries.
INGEST_DATABASE_URL=postgresql+asyncpg://sageboard_ingest:change-me-ingest@localhost:5432/sageboard
# Read-only role for previews (and, from Phase 4, validated agent SQL). Each query switches
# to the dataset's own reader role inside a READ ONLY transaction with a timeout.
EXECUTOR_DATABASE_URL=postgresql+asyncpg://sageboard_executor:change-me-executor@localhost:5432/sageboard
EXECUTOR_STATEMENT_TIMEOUT_MS=10000

# --- Uploads -------------------------------------------------------------
UPLOAD_MAX_BYTES=26214400        # 25 MB
UPLOAD_MAX_ROWS=1000000
UPLOAD_MAX_COLUMNS=200
UPLOAD_TTL_MINUTES=60            # unreviewed uploads are deleted after this
# UPLOAD_DIR=/tmp/sageboard-uploads   # default: system temp dir; created with mode 0700
PREVIEW_MAX_ROWS=100

# --- Identity (until real authentication) --------------------------------
# Every request acts as this seeded user. Refused at startup when ENV=production.
AUTH_MODE=demo
DEMO_USER_EMAIL=demo@sageboard.local

# --- LLM (adapter implemented in Phase 5) --------------------------------
# mock | anthropic | openai | gemini.  `mock` is refused when ENV=production.
LLM_PROVIDER=mock
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
