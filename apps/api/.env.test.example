# Integration-test database URLs. Copy the lines into your shell (or a gitignored
# .env.test you `source`) — pytest reads them from the ENVIRONMENT, not from a file.
#
# Use a DEDICATED database: the migration test downgrades it to empty.
#   bash infra/postgres/setup-local.sh --db sageboard_test
#
# Port: 5432 for Homebrew / Postgres.app; use your own if different.
export SAGEBOARD_TEST_DATABASE_URL=postgresql+asyncpg://sageboard_app:change-me-app@localhost:5432/sageboard_test
export SAGEBOARD_TEST_INGEST_DATABASE_URL=postgresql+asyncpg://sageboard_ingest:change-me-ingest@localhost:5432/sageboard_test
export SAGEBOARD_TEST_EXECUTOR_DATABASE_URL=postgresql+asyncpg://sageboard_executor:change-me-executor@localhost:5432/sageboard_test
export SAGEBOARD_TEST_MIGRATION_DATABASE_URL=postgresql+asyncpg://sageboard_owner:change-me-owner@localhost:5432/sageboard_test
